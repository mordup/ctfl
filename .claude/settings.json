{
  "permissions": {
    "allow": [
      "Bash(bash scripts/dev-run.sh:*)",
      "Bash(bash scripts/smoke.sh:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(**/.claude/.credentials.json)",
      "Read(**/.cache/ctfl/*.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-sensitive-files.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.py) ruff check --fix --ignore F401 \"$f\" ;; esac; } 2>/dev/null || true",
            "statusMessage": "Running ruff..."
          }
        ]
      }
    ]
  }
}

